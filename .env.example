# Copia este archivo como .env y completa los datos.

# Supabase: sincronización entre dispositivos y acceso a TMDB a través del servidor.
# Ambos valores son públicos (la seguridad la dan las reglas de la base de datos).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para desarrollo sin Supabase: token de lectura de TMDB (https://www.themoviedb.org/settings/api).
# Con Supabase configurado, déjalo vacío: el token vive en el servidor (secreto TMDB_TOKEN).
EXPO_PUBLIC_TMDB_TOKEN=

# Idioma de los títulos y sinopsis, y país para "Dónde ver".
EXPO_PUBLIC_LANGUAGE=es-MX
EXPO_PUBLIC_REGION=CO
